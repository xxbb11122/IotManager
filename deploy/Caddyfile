{
	email {$ACME_EMAIL}
}

(common_security) {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), bluetooth=(self), camera=()"
	}
}

(static_security) {
	import common_security
	header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' wss://{$DOMAIN}"
}

# Caddy is the public browser ingress. Keep its allow-list aligned with the
# backend's IOT_ALLOWED_ORIGINS value so upstream CORS headers cannot be lost
# or weakened by a proxy-layer change.
(api_cors) {
	@api_cors_origin header Origin {args[0]}
	header @api_cors_origin Access-Control-Allow-Origin "{args[0]}"
	header @api_cors_origin Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
	header @api_cors_origin Access-Control-Allow-Headers "Authorization, Content-Type, X-Request-Id, X-Trace-Id, If-Match, Idempotency-Key, X-Requested-With, X-Iot-Agent-Credential, X-Iot-Agent-Token"
	header @api_cors_origin Access-Control-Expose-Headers "X-Request-Id, X-Trace-Id, Retry-After"
	header @api_cors_origin Access-Control-Max-Age "600"
	header @api_cors_origin +Vary "Origin"
}

# request_body guards bytes when a downstream handler reads them. Reject known
# oversized and chunked API payloads before authentication/proxying as well,
# so an unauthenticated request cannot turn a gateway-size violation into 401.
(api_body_guard) {
	@api_content_length_over_limit header_regexp Content-Length ^0*(?:100000[1-9]|10000[1-9][0-9]|1000[1-9][0-9]{2}|100[1-9][0-9]{3}|10[1-9][0-9]{4}|1[1-9][0-9]{5}|[2-9][0-9]{6}|[1-9][0-9]{7,})$
	respond @api_content_length_over_limit 413
	@api_chunked_body header Transfer-Encoding *chunked*
	respond @api_chunked_body 413
}

http://{$DOMAIN} {
	redir https://{$DOMAIN}{uri} 308
}

https://{$DOMAIN} {
	encode zstd gzip

	# Keep API, WebSocket and Keycloak routes ahead of SPA fallback handling.
	route {
		@identity path /auth /auth/*
		handle @identity {
			import common_security
			reverse_proxy keycloak:8080 {
				header_up X-Forwarded-Proto https
				header_up X-Real-IP {remote_host}
			}
		}

		@platform path /api /api/* /ws /ws/*
		handle @platform {
			import common_security
			import api_cors https://{$DOMAIN}
			import api_body_guard
			request_body {
				max_size 1MB
			}
			reverse_proxy backend:8080 {
				header_up X-Forwarded-Proto https
				header_up X-Real-IP {remote_host}
			}
		}

		# Never let SPA fallback turn private runtime endpoints into a successful
		# static response. H2 is disabled in prod; Actuator stays Docker-internal.
		@privateRuntime path /h2-console /h2-console/* /actuator /actuator/*
		respond @privateRuntime 404

		@consoleRoot path /console
		redir @consoleRoot /console/ permanent

		handle_path /console/* {
			import static_security
			root * /srv/console
			try_files {path} /index.html
			file_server
		}

		handle {
			import static_security
			root * /srv/frontend
			try_files {path} /index.html
			file_server
		}
	}
}
