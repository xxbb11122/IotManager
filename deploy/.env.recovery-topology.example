# Used only by scripts/ci discovery commands together with Docker Compose
# config. These values must never be used to execute a recovery drill.
IOT_RECOVERY_TARGET_NAME=topology-discovery-placeholder
IOT_RECOVERY_BASE_BACKUP=base_topology_placeholder
WALG_STORAGE_MODE=s3
WALG_S3_PREFIX=s3://topology-placeholder/iot-manager
AWS_REGION=us-east-1
AWS_ENDPOINT=https://topology.invalid
AWS_S3_FORCE_PATH_STYLE=true
WALG_COMPRESSION_METHOD=zstd
