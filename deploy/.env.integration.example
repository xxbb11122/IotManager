# Copy to deploy/.env.integration for the local full-stack Gate 2 run.
# This file deliberately contains no secret values. Generate them with
# scripts/runtime/new-secrets.ps1 or scripts/runtime/new-secrets.sh.
DOMAIN=iot-manager.localhost
ACME_EMAIL=integration@example.invalid
TZ=Asia/Shanghai

POSTGRES_BOOTSTRAP_USERNAME=iot_postgres_admin
IOT_DB_DATABASE=iot_manager
IOT_DB_OWNER_USERNAME=iot_manager_owner
IOT_DB_USERNAME=iot_manager_app
IOT_DB_URL=jdbc:postgresql://postgres:5432/iot_manager
KEYCLOAK_DB_DATABASE=keycloak
KEYCLOAK_DB_USERNAME=keycloak

KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=kc-admin
KEYCLOAK_REALM=iot-manager
IOT_WEB_ORIGIN=https://iot-manager.localhost
# Keep this exact integration origin aligned with Caddyfile.integration.
IOT_ALLOWED_ORIGINS=https://iot-manager.localhost
IOT_DASHBOARD_REDIRECT_URI=https://iot-manager.localhost/
IOT_CONSOLE_REDIRECT_URI=https://iot-manager.localhost/console/
IOT_MOBILE_REDIRECT_URI=com.iot.manager.client://oauth/callback

IOT_BOOTSTRAP_OWNER_SUBJECT=
IOT_BOOTSTRAP_OWNER_USERNAME=integration-owner
IOT_BOOTSTRAP_OWNER_DISPLAY_NAME=Integration Owner
IOT_BOOTSTRAP_OWNER_EMAIL=integration-owner@example.invalid
IOT_BOOTSTRAP_ORGANIZATION_CODE=primary-org
IOT_BOOTSTRAP_ORGANIZATION_NAME=Primary Organization
IOT_BOOTSTRAP_SITE_CODE=primary-site
IOT_BOOTSTRAP_SITE_NAME=Primary Site
IOT_BOOTSTRAP_SECONDARY_SITE_CODE=restricted-site
IOT_BOOTSTRAP_SECONDARY_SITE_NAME=Restricted Site
IOT_BOOTSTRAP_SPACE_PATH=/operations
IOT_BOOTSTRAP_SPACE_NAME=Operations
# The integration launcher creates all four platform roles, then writes their
# verified Keycloak subjects into protected runtime.env before Backend starts.
# Production configurations keep this false and bootstrap only the OWNER.
IOT_CREATE_INTEGRATION_IDENTITIES=true
IOT_BOOTSTRAP_ADMIN_SUBJECT=
IOT_ADMIN_USERNAME=integration-admin
IOT_ADMIN_DISPLAY_NAME=Integration Admin
IOT_ADMIN_EMAIL=integration-admin@example.invalid
IOT_BOOTSTRAP_OPERATOR_SUBJECT=
IOT_OPERATOR_USERNAME=integration-operator
IOT_OPERATOR_DISPLAY_NAME=Integration Operator
IOT_OPERATOR_EMAIL=integration-operator@example.invalid
IOT_BOOTSTRAP_VIEWER_SUBJECT=
IOT_VIEWER_USERNAME=integration-viewer
IOT_VIEWER_DISPLAY_NAME=Integration Viewer
IOT_VIEWER_EMAIL=integration-viewer@example.invalid
# Backward-compatible switch for older stacks. The all-role switch above is
# authoritative for a new integration runtime.
IOT_CREATE_INTEGRATION_VIEWER=true

IOT_RATE_LIMIT_READS_PER_MINUTE=120
IOT_RATE_LIMIT_COMMANDS_PER_MINUTE=30
BACKUP_RETENTION_DAYS=2
BACKUP_INTERVAL_SECONDS=300
WALG_BACKUP_INTERVAL_SECONDS=300
WALG_STORAGE_MODE=filesystem
WALG_FILE_PREFIX=/var/lib/wal-g
WALG_S3_PREFIX=
AWS_ENDPOINT=
AWS_REGION=us-east-1
AWS_S3_FORCE_PATH_STYLE=true
WALG_COMPRESSION_METHOD=zstd
IOT_SECRET_DIR=./.runtime/iot-manager-p0/secrets
