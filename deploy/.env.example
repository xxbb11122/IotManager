# Non-secret production-shaped Compose configuration. Copy this file to
# deploy/.env and create the referenced secret files out of band. Never place
# passwords, access keys or HMAC values in this file.
DOMAIN=iot.example.com
ACME_EMAIL=ops@example.com
TZ=Asia/Shanghai

# PostgreSQL role names. POSTGRES_BOOTSTRAP_USERNAME is a cluster-management
# account only; applications never use it.
POSTGRES_BOOTSTRAP_USERNAME=iot_postgres_admin
IOT_DB_DATABASE=iot_manager
IOT_DB_OWNER_USERNAME=iot_manager_owner
IOT_DB_USERNAME=iot_manager_app
IOT_DB_URL=jdbc:postgresql://postgres:5432/iot_manager
KEYCLOAK_DB_DATABASE=keycloak
KEYCLOAK_DB_USERNAME=keycloak

# Keycloak public-client configuration.
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=kc-admin
KEYCLOAK_REALM=iot-manager
IOT_WEB_ORIGIN=https://iot.example.com
# P0 Caddy ingress permits this one exact browser origin. Keep it equal to
# https://DOMAIN; multi-origin CORS requires a reviewed Caddy allow-list change.
IOT_ALLOWED_ORIGINS=https://iot.example.com
IOT_DASHBOARD_REDIRECT_URI=https://iot.example.com/
IOT_CONSOLE_REDIRECT_URI=https://iot.example.com/console/
IOT_MOBILE_REDIRECT_URI=com.iot.manager.client://oauth/callback

# Bootstrap mapping. The subject is written by the OWNER bootstrap script to
# a protected runtime state file before the backend is started.
IOT_BOOTSTRAP_OWNER_SUBJECT=
IOT_BOOTSTRAP_OWNER_USERNAME=owner
IOT_BOOTSTRAP_OWNER_DISPLAY_NAME=Initial Owner
IOT_BOOTSTRAP_OWNER_EMAIL=owner@example.com
IOT_BOOTSTRAP_ORGANIZATION_CODE=primary-org
IOT_BOOTSTRAP_ORGANIZATION_NAME=Primary Organization
IOT_BOOTSTRAP_SITE_CODE=primary-site
IOT_BOOTSTRAP_SITE_NAME=Primary Site
# Optional R1 second site. Leave both values blank until the controlled pilot
# topology and its site membership plan have been approved.
IOT_BOOTSTRAP_SECONDARY_SITE_CODE=
IOT_BOOTSTRAP_SECONDARY_SITE_NAME=
IOT_BOOTSTRAP_SPACE_PATH=/operations
IOT_BOOTSTRAP_SPACE_NAME=Operations
# These identities are integration-only. Keep them disabled and empty in
# production; only the explicitly configured OWNER is bootstrapped there.
IOT_CREATE_INTEGRATION_IDENTITIES=false
IOT_BOOTSTRAP_ADMIN_SUBJECT=
IOT_ADMIN_USERNAME=
IOT_ADMIN_DISPLAY_NAME=
IOT_ADMIN_EMAIL=
IOT_BOOTSTRAP_OPERATOR_SUBJECT=
IOT_OPERATOR_USERNAME=
IOT_OPERATOR_DISPLAY_NAME=
IOT_OPERATOR_EMAIL=
# The optional viewer subject is emitted to protected runtime state only when
# IOT_CREATE_INTEGRATION_VIEWER=true. Keep it empty for ordinary production
# deployments; a viewer must be intentionally provisioned and assigned later.
IOT_BOOTSTRAP_VIEWER_SUBJECT=
IOT_VIEWER_USERNAME=integration-viewer
IOT_VIEWER_DISPLAY_NAME=Integration Viewer
IOT_VIEWER_EMAIL=integration-viewer@example.com
IOT_CREATE_INTEGRATION_VIEWER=false

IOT_RATE_LIMIT_READS_PER_MINUTE=120
IOT_RATE_LIMIT_COMMANDS_PER_MINUTE=30
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=86400
WALG_BACKUP_INTERVAL_SECONDS=900

# Production intentionally fails closed until an S3-compatible, encrypted and
# immutable backup bucket is supplied. The integration override alone may use
# its isolated filesystem backend.
WALG_STORAGE_MODE=s3
WALG_FILE_PREFIX=
WALG_S3_PREFIX=s3://replace-with-immutable-backup-bucket/iot-manager
AWS_ENDPOINT=
AWS_REGION=us-east-1
AWS_S3_FORCE_PATH_STYLE=true
WALG_COMPRESSION_METHOD=zstd

# Relative paths resolve from deploy/. Use an absolute, root-controlled path on
# production hosts, for example /etc/iot-manager/secrets.
IOT_SECRET_DIR=./.runtime/iot-manager-p0/secrets
