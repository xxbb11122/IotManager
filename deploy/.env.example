# Public DNS and ACME contact. DOMAIN has no protocol or path.
DOMAIN=iot.example.com
ACME_EMAIL=ops@example.com
TZ=Asia/Shanghai

# PostgreSQL. Use a unique high-entropy password; do not commit deploy/.env.
IOT_DB_DATABASE=iot_manager
IOT_DB_USERNAME=iot_manager
IOT_DB_PASSWORD=replace-with-a-long-random-password
IOT_DB_URL=jdbc:postgresql://postgres:5432/iot_manager

# Keycloak database and bootstrap administrator. The bootstrap administrator is
# only used to configure the realm; rotate/remove it through normal operations.
KEYCLOAK_DB_DATABASE=keycloak
KEYCLOAK_DB_USERNAME=keycloak
# This may contain '$'; Compose maps it to Keycloak's KCRAW_DB_PASSWORD so it
# is preserved literally by Keycloak's configuration resolver.
KEYCLOAK_DB_PASSWORD=replace-with-a-different-long-random-password
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=kc-admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-third-long-random-password
KEYCLOAK_REALM=iot-manager

# Public-client OIDC configuration imported into Keycloak.
IOT_WEB_ORIGIN=https://iot.example.com
IOT_WEB_REDIRECT_URI=https://iot.example.com/*
IOT_MOBILE_REDIRECT_URI=com.iot.manager.client://oauth/callback

# One-time initial OWNER mapping. Create the Keycloak user, assign the OWNER
# realm role, copy its immutable subject UUID here, then start the backend.
IOT_BOOTSTRAP_OWNER_SUBJECT=replace-with-keycloak-user-subject
IOT_BOOTSTRAP_OWNER_USERNAME=owner
IOT_BOOTSTRAP_OWNER_DISPLAY_NAME=Initial Owner
IOT_BOOTSTRAP_OWNER_EMAIL=owner@example.com
IOT_BOOTSTRAP_ORGANIZATION_CODE=primary-org
IOT_BOOTSTRAP_ORGANIZATION_NAME=Primary Organization
IOT_BOOTSTRAP_SITE_CODE=primary-site
IOT_BOOTSTRAP_SITE_NAME=Primary Site
IOT_BOOTSTRAP_SPACE_PATH=/operations
IOT_BOOTSTRAP_SPACE_NAME=Operations

# Single-node R1 rate limits and local backup retention. R2 requires an
# external encrypted/immutable backup target plus continuous WAL archiving.
IOT_RATE_LIMIT_READS_PER_MINUTE=120
IOT_RATE_LIMIT_COMMANDS_PER_MINUTE=30
IOT_WEATHER_FINGERPRINT_SECRET=replace-with-a-fourth-long-random-secret
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=86400
