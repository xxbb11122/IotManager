{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iot-manager.example/schemas/stage-result.schema.json",
  "title": "IoT Manager Release Stage Result",
  "type": "object",
  "required": [
    "schemaVersion",
    "releaseCandidateId",
    "sourceSha",
    "requestedSourceSha",
    "checkedOutSourceSha",
    "checkoutVerified",
    "topologySha256",
    "manifestSha256",
    "producerRepository",
    "producerEvent",
    "invocationMode",
    "callerRepository",
    "callerWorkflowRefRaw",
    "callerWorkflowSha",
    "callerWorkflowPath",
    "callerWorkflowIdentity",
    "producerRunId",
    "producerRunAttempt",
    "producerWorkflowRefRaw",
    "producerWorkflowSha",
    "producerWorkflowPath",
    "producerWorkflowIdentity",
    "producerJob",
    "artifactName",
    "orchestratorRunId",
    "runnerClass",
    "stage",
    "trustedProducer"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releaseCandidateId": { "type": "string", "pattern": "^r1-rc[._-].+-[0-9a-f]{12}$" },
    "sourceSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "requestedSourceSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "checkedOutSourceSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "checkoutVerified": { "const": true },
    "topologySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "manifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "producerRepository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
    "producerEvent": { "type": "string", "minLength": 1 },
    "invocationMode": { "enum": ["orchestrated-reusable", "protected-fallback-dispatch"] },
    "callerRepository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
    "callerWorkflowRefRaw": { "type": "string", "minLength": 1 },
    "callerWorkflowSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "callerWorkflowPath": { "type": "string", "pattern": "^\\.github/workflows/[^/]+\\.ya?ml$" },
    "callerWorkflowIdentity": { "type": "string", "minLength": 1 },
    "producerWorkflowSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "producerWorkflowPath": { "type": "string", "pattern": "^\\.github/workflows/[^/]+\\.ya?ml$" },
    "producerWorkflowIdentity": { "type": "string" },
    "artifactName": { "type": "string", "minLength": 1 },
    "orchestratorRunId": { "oneOf": [{ "type": "string", "pattern": "^[0-9]+$" }, { "type": "integer", "minimum": 1 }] },
    "producerRunId": { "oneOf": [{ "type": "string", "pattern": "^[0-9]+$" }, { "type": "integer", "minimum": 1 }] },
    "producerRunAttempt": { "type": "integer", "minimum": 1 },
    "runnerClass": { "enum": ["github-hosted", "larger-runner", "self-hosted-ephemeral"] },
    "stage": { "enum": ["image", "runtime", "recovery", "gate"] },
    "trustedProducer": { "type": "boolean" }
  }
}
