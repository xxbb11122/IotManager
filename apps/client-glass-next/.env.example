# Physical Android/PDA builds: replace the host with the backend computer's
# LAN address. This example is intentionally non-routable for the project.
VITE_NATIVE_API_BASE_URL=http://192.168.1.100:8080/api/v1
VITE_NATIVE_WS_URL=ws://192.168.1.100:8080/ws/devices

# Public login metadata: register this independent callback in your realm.
# VITE_NATIVE_OIDC_ISSUER_URL=https://auth.example.com/realms/iot
# VITE_NATIVE_OIDC_CLIENT_ID=iot-glass-next
# VITE_NATIVE_OIDC_REDIRECT_URI=com.iot.manager.glassnext://oauth/callback
# VITE_OIDC_ISSUER_URL=https://auth.example.com/realms/iot
# VITE_OIDC_CLIENT_ID=iot-glass-next
# VITE_OIDC_REDIRECT_URI=http://127.0.0.1:5190/
